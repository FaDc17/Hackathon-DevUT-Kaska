# Local backend. Copy to .env.local and replace only after checking the server.
VITE_API_BASE_URL=http://localhost:8080
# Existing App Service: public catalogs return HTTP 200; health still returns HTTP 401.
# VITE_API_BASE_URL=https://kuska-api-fadc-akd8fkcrfpcwdgdj.eastus2-01.azurewebsites.net
# Local browser authentication is opt-in, development only. Android always uses JWT.
VITE_ENABLE_LOCAL_AUTH=false
# Vite embeds these values at build time. Rebuild and run cap sync after changing them.
